---
import DefaultHeader from "@astrojs/starlight/components/Header.astro";
import SocialIcons from "@astrojs/starlight/components/SocialIcons.astro";
import LanguageSelect from "./LanguageSelect.astro";
import { localePath, pageLang } from "./i18n";
import { getSiteConfig } from "../../scripts/site-config.mjs";

const { base } = getSiteConfig();
const lang = pageLang(Astro.locals);
// 首页右上角加文档入口和主按钮
const isHome = ["", "en"].includes(Astro.locals.starlightRoute.id);
const cta =
  lang === "en" ? { docs: "Docs", start: "Get started" } : { docs: "文档", start: "开始使用" };
---

<div class="hive-header">
  <DefaultHeader />
  {
    /* 窄屏时 Starlight 把社交图标和语言切换收进侧栏菜单，首页没有侧栏就看不到；这里在顶栏单独放一份 */
  }
  <div class="hive-header-social print:hidden">
    <LanguageSelect />
    <SocialIcons />
  </div>
  {
    isHome && (
      <div class="hive-header-cta print:hidden">
        <a class="hive-header-docs" href={localePath("start/overview/", lang, base)}>
          {cta.docs}
        </a>
        <a class="hive-header-start" href={localePath("start/quickstart/", lang, base)}>
          {cta.start}
        </a>
      </div>
    )
  }
</div>

<style>
  .hive-header {
    display: flex;
    gap: var(--sl-nav-gap);
    align-items: center;
    height: 100%;
  }

  .hive-header > :global(.header) {
    flex: 1;
    min-width: 0;
  }

  .hive-header-social {
    display: flex;
    flex-shrink: 0;
    gap: 0.25rem;
    align-items: center;
  }

  .hive-header-cta {
    display: flex;
    flex-shrink: 0;
    gap: 0.25rem;
    align-items: center;
  }

  .hive-header-cta a {
    display: inline-flex;
    align-items: center;
    height: 2.1rem;
    padding: 0 0.85rem;
    border-radius: 999px;
    font-size: var(--sl-text-sm);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  .hive-header-docs {
    color: var(--sl-color-gray-2);
  }

  .hive-header-docs:hover {
    color: var(--sl-color-white);
  }

  .hive-header-start {
    background: var(--docs-button-bg);
    color: var(--docs-button-text);
  }

  .hive-header-start:hover {
    background: var(--docs-button-hover);
  }

  /* 手机上顶栏放不下，首屏本身就有「下载客户端」和「快速上手」 */
  @media (max-width: 36rem) {
    .hive-header-cta {
      display: none;
    }
  }

  @media (min-width: 50rem) {
    .hive-header-social {
      display: none;
    }
  }
</style>
