{
  "name": "@superhive/desktop",
  "productName": "SuperHive",
  "version": "0.5.0",
  "private": true,
  "description": "SuperHive desktop app: runs the local Hive and opens it in its own window, with a built-in terminal.",
  "author": "SuperHive",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": ".stage/app/main.cjs",
  "scripts": {
    "stage": "node scripts/stage.mjs",
    "dev": "node scripts/stage.mjs && electron .stage/app",
    "start": "electron .stage/app",
    "icons": "node scripts/icons.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:smoke": "node scripts/stage.mjs && playwright test",
    "package": "node scripts/stage.mjs --rebuild && node scripts/forge.mjs package",
    "make": "node scripts/stage.mjs --rebuild && node scripts/forge.mjs make",
    "release-assets": "node scripts/release-assets.mjs"
  },
  "dependencies": {
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-dmg": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@electron/rebuild": "^4.2.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.13.3",
    "electron": "45.4.1",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "superhiveDesktop": {
    "dependencyOverrides": {
      "better-sqlite3": "13.2.0"
    },
    "_comment": "better-sqlite3 12.x 在 Electron 45 的 V8 上编译不过；13.x 走 N-API，和 Electron 版本无关"
  }
}
