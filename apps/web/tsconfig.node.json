{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "outDir": "node_modules/.cache/vite-config"
  },
  "include": [
    "vite.config.ts",
    "dev-status-plugin.ts",
    "favicon-plugin.ts",
    "pptx-preview-plugin.ts",
    "src/dev-status.ts"
  ]
}
