{
  "name": "superhive-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "A self-hosted shared workspace for humans, Codex, Claude Code, Copilot, OpenClaw, and extensible agents.",
  "type": "module",
  "scripts": {
    "pretest": "pnpm --filter @superhive/protocol build",
    "dev": "node scripts/dev.mjs",
    "build": "pnpm -r --workspace-concurrency=1 build",
    "test": "pnpm test:dev && pnpm -r --if-present test",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "start": "pnpm --filter @superhive/server start",
    "agent": "pnpm --filter superhive dev",
    "agent:echo": "pnpm --filter superhive echo",
    "test:dev": "node --test scripts/dev-supervisor.test.mjs scripts/dev-reload.test.mjs",
    "test:dev:smoke": "node scripts/dev-supervisor.smoke.mjs"
  },
  "keywords": [
    "codex",
    "claude-code",
    "github-copilot",
    "openclaw",
    "agent",
    "chat"
  ],
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "superhive": "workspace:*",
    "concurrently": "^9.2.0",
    "eslint": "^9.31.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.4"
  }
}
