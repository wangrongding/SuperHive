{
  "name": "superhive-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "An open-source shared workspace for humans and AI coding agents. Run it on your own computer or a cloud server and open it in the browser.",
  "type": "module",
  "scripts": {
    "prepare": "node scripts/git-hooks.mjs install",
    "pretest": "pnpm --filter @superhive/protocol build",
    "dev": "node scripts/dev.mjs",
    "build": "pnpm -r --workspace-concurrency=1 build",
    "test": "pnpm test:dev && pnpm -r --workspace-concurrency=1 --if-present test",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "start": "pnpm --filter @superhive/server start",
    "agent": "pnpm --filter superhive dev",
    "agent:echo": "pnpm --filter superhive echo",
    "preview:sandbox": "node scripts/preview-sandbox.mjs",
    "screenshot": "node scripts/screenshot.mjs",
    "docs:dev": "pnpm --filter @superhive/docs dev",
    "docs:build": "pnpm --filter @superhive/docs build",
    "docs:check": "pnpm --filter @superhive/docs check",
    "docs:verify": "pnpm --filter @superhive/docs verify",
    "docs:screens": "pnpm --filter @superhive/docs screens",
    "test:dev": "node --test scripts/dev-supervisor.test.mjs scripts/dev-reload.test.mjs scripts/preview-sandbox.test.mjs scripts/git-hooks.test.mjs",
    "test:dev:smoke": "node scripts/dev-supervisor.smoke.mjs",
    "test:dev:handover": "node scripts/dev-handover.smoke.mjs"
  },
  "keywords": [
    "codex",
    "claude-code",
    "github-copilot",
    "openclaw",
    "agent",
    "chat"
  ],
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron-winstaller",
      "esbuild",
      "fs-xattr",
      "macos-alias"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "superhive": "workspace:*",
    "concurrently": "^9.2.0",
    "eslint": "^9.31.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.4"
  }
}
